# Normalize line endings so Windows/macOS collaborators don't fight over CRLF vs LF.
* text=auto eol=lf

# Binary files — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.zip binary
*.exe binary
*.dmg binary
*.node binary

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
