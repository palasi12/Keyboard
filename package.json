{
  "name": "keydeck",
  "version": "0.1.0",
  "private": true,
  "description": "An affordable, open stream deck. Software first.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty",
    "dev:desktop": "npm run dev -w @keydeck/desktop",
    "dev:web": "npm run dev -w @keydeck/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
