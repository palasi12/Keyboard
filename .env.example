# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase (accounts) -----------------------------------------------------
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Stripe (checkout) -------------------------------------------------------
# Only the PUBLISHABLE key belongs here. It starts with pk_.
# The secret key (sk_) must NEVER appear in this file or anywhere in this repo —
# anything here gets compiled into the JavaScript every visitor downloads.
VITE_STRIPE_PUBLISHABLE_KEY=

# URL of the server endpoint that creates Stripe Checkout sessions.
# Leave blank until you have built it — see docs/CHECKOUT.md.
VITE_CHECKOUT_ENDPOINT=
