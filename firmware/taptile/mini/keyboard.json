{
  "manufacturer": "Taptile",
  "keyboard_name": "Taptile Mini",
  "maintainer": "taptile",
  "url": "https://www.trytaptile.com",

  "processor": "RP2040",
  "bootloader": "rp2040",

  "usb": {
    "vid": "0xFEED",
    "pid": "0x0001",
    "device_version": "0.0.1"
  },

  "features": {
    "bootmagic": true,
    "extrakey": true,
    "mousekey": false,
    "nkro": true,
    "encoder": true,
    "console": false,
    "command": false
  },

  "matrix_pins": {
    "direct": [
      ["GP0", "GP1", "GP2"],
      ["GP3", "GP4", "GP5"],
      ["GP6", "GP7", "GP8"],
      ["GP18", "GP26", null]
    ]
  },

  "encoder": {
    "rotary": [
      { "pin_a": "GP9",  "pin_b": "GP10" },
      { "pin_a": "GP19", "pin_b": "GP20" }
    ]
  },

  "layouts": {
    "LAYOUT": {
      "layout": [
        { "matrix": [0, 0], "x": 0, "y": 0 },
        { "matrix": [0, 1], "x": 1, "y": 0 },
        { "matrix": [0, 2], "x": 2, "y": 0 },

        { "matrix": [1, 0], "x": 0, "y": 1 },
        { "matrix": [1, 1], "x": 1, "y": 1 },
        { "matrix": [1, 2], "x": 2, "y": 1 },

        { "matrix": [2, 0], "x": 0, "y": 2 },
        { "matrix": [2, 1], "x": 1, "y": 2 },
        { "matrix": [2, 2], "x": 2, "y": 2 },

        { "matrix": [3, 0], "x": 0.5, "y": 3.25 },
        { "matrix": [3, 1], "x": 1.5, "y": 3.25 }
      ]
    }
  }
}
